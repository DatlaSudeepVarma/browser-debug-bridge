{
  "name": "browser-debug-bridge-vscode",
  "displayName": "Browser Debug Bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser debugging session → project-aware diagnosis → proposed code fix.",
  "publisher": "browser-debug-bridge",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "browserDebugBridge.hello",
        "title": "Hello",
        "category": "Browser Debug Bridge"
      },
      {
        "command": "browserDebugBridge.showPairingCode",
        "title": "Show Pairing Code",
        "category": "Browser Debug Bridge"
      },
      {
        "command": "browserDebugBridge.startLocalBridge",
        "title": "Start Local Bridge",
        "category": "Browser Debug Bridge"
      },
      {
        "command": "browserDebugBridge.stopLocalBridge",
        "title": "Stop Local Bridge",
        "category": "Browser Debug Bridge"
      },
      {
        "command": "browserDebugBridge.createTestSession",
        "title": "Create Test Session",
        "category": "Browser Debug Bridge"
      },
      {
        "command": "browserDebugBridge.analyzeTestSession",
        "title": "Analyze Test Session",
        "category": "Browser Debug Bridge"
      },
      {
        "command": "browserDebugBridge.diagnoseTestSession",
        "title": "Diagnose Test Session",
        "category": "Browser Debug Bridge"
      },
      {
        "command": "browserDebugBridge.refreshDiagnosis",
        "title": "Refresh Diagnosis",
        "category": "Browser Debug Bridge",
        "icon": "$(refresh)"
      },
      {
        "command": "browserDebugBridge.clearDiagnosis",
        "title": "Clear Diagnosis",
        "category": "Browser Debug Bridge",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "browserDebugBridge",
          "title": "Browser Debug Bridge",
          "icon": "media/debug-bridge.svg"
        }
      ]
    },
    "views": {
      "browserDebugBridge": [
        {
          "id": "browserDebugBridge.diagnosis",
          "name": "Diagnosis"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "browserDebugBridge.diagnosis",
        "contents": "No diagnosis available.\n\nRun \"Browser Debug Bridge: Diagnose Test Session\""
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "browserDebugBridge.refreshDiagnosis",
          "when": "view == browserDebugBridge.diagnosis",
          "group": "navigation"
        },
        {
          "command": "browserDebugBridge.clearDiagnosis",
          "when": "view == browserDebugBridge.diagnosis",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Browser Debug Bridge",
      "properties": {
        "browserDebugBridge.chromeExtensionId": {
          "type": "string",
          "default": "",
          "description": "Stable Chrome extension ID used to validate Origin headers from the unpacked/published extension. Copy it from chrome://extensions after loading the extension. Browser requests are rejected until this is set. Requests without an Origin header are allowed for local VS Code/curl testing only."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test src/bridge/http-server.test.ts src/bridge/screenshot-store.test.ts src/project/framework.test.ts src/project/package-manager.test.ts src/project/signals.test.ts src/project/workspace.test.ts src/project/scoring.test.ts src/project/excerpts.test.ts src/project/service.test.ts src/ai/serializer.test.ts src/ai/validation.test.ts src/ai/diagnosis.test.ts src/ui/plain-text.test.ts src/ui/evidence-refs.test.ts src/ui/ai-errors.test.ts src/ui/diagnosis-state.test.ts src/ui/diagnosis-tree.test.ts src/ui/open-path.test.ts src/ui/open-candidate.test.ts src/ui/run-diagnosis.test.ts src/ui/notifications.test.ts"
  },
  "dependencies": {
    "@browser-debug-bridge/redaction": "workspace:*",
    "@browser-debug-bridge/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.90.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
